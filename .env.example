LLM_MODEL=qwen-plus
llm_api_key=replace-with-your-model-api-key
llm_base_url=https://dashscope.aliyuncs.com/compatible-mode/v1
database_url=mysql+aiomysql://opspilot:replace-with-url-encoded-password@127.0.0.1:3306/opspilot?charset=utf8mb4
ops_api_base_url=mock://opspilot
app_host=0.0.0.0
app_port=18082

# Docker Compose: use alphanumeric passwords for URL compatibility.
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password
